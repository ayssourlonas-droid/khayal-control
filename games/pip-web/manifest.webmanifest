{"name":"pip","short_name":"pip","description":"Casual poker, redesigned. Clean single-player Texas Hold’em — play money, no account needed.","id":"/game","start_url":"/game","display":"standalone","categories":["games"],"orientation":"portrait","background_color":"#0a0a0b","theme_color":"#0a0a0b","icons":[{"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/icons/icon-512.png","sizes":"512x512","type":"image/png"},{"src":"/icons/icon-512-maskable.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],"screenshots":[{"src":"/screenshots/phone-1-table.webp","sizes":"1080x1920","type":"image/png","form_factor":"narrow","label":"A hand in progress at The Pub: four community cards face up, the player's two hole cards at 92% to win, and Fold, Check and Bet buttons."},{"src":"/screenshots/phone-2-opponent.webp","sizes":"1080x1920","type":"image/png","form_factor":"narrow","label":"An opponent's profile: Elaine, loose and aggressive, with her chips, her bankroll, three read bars and a note that you have played fourteen hands together."},{"src":"/screenshots/phone-3-venues.webp","sizes":"1080x1920","type":"image/png","form_factor":"narrow","label":"The venue ladder: rooms as illustrated cards, each showing its buy-in and what it pays to win."},{"src":"/screenshots/phone-4-home.webp","sizes":"1080x1920","type":"image/png","form_factor":"narrow","label":"The home screen: a Roll of 18,420 chips, the next venue on the ladder, a cash table, and progress up the ladder."},{"src":"/screenshots/phone-5-cash.webp","sizes":"1080x1920","type":"image/png","form_factor":"narrow","label":"The Rail: cash tables by stake, from 1/2 up, each showing table size, stack depth and the chips to sit down."},{"src":"/screenshots/desktop-1-table.webp","sizes":"1920x1080","type":"image/png","form_factor":"wide","label":"A hand in progress at The Card Room: four community cards face up, a pot of 4,781 chips, an opponent all in, and Fold, Call and Raise buttons."},{"src":"/screenshots/desktop-2-opponent.webp","sizes":"1920x1080","type":"image/png","form_factor":"wide","label":"An opponent's profile: Rosa, loose and passive, with her chips, her bankroll, three read bars and a note that you have played fourteen hands together."},{"src":"/screenshots/desktop-3-venues.webp","sizes":"1920x1080","type":"image/png","form_factor":"wide","label":"The venue ladder on a wide screen: eight of the ten rooms as illustrated cards, from Friends' Garage to Monte Carlo."}]}